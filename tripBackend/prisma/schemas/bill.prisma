enum PaymentMethodStatusEnum {
    active
    error
    inactive

    @@map("Payment_Method_Status_Enum")
}

enum TransactionTargetEnum {
    deposit
    withdrawal
    pay
    refund

    @@map("Transaction_Target_Enum")
}

enum TransactionStatusEnum {
    pending
    completed
    canceled

    @@map("Transaction_Status_Enum")
}

enum BillStatusEnum {
    done
    paid
    pending
    cancel
    refunded
    waitingRefund @map("waiting_refund")

    @@map("Bill_Status_Enum")
}

model transactionSession {
    id              String        @id @default(cuid())
    billId          String
    /// @DtoRelationCanConnectOnCreate
    /// @DtoUpdateHidden
    bill            bill          @relation(fields: [billId], references: [id])
    paymentMethodId String        @map("payment_method_id")
    /// @DtoRelationCanConnectOnCreate
    paymentMethod   paymentMethod @relation(fields: [paymentMethodId], references: [id])

    @@map("Transaction_Session")
}

model paymentMethod {
    id          String                  @id @default(cuid())
    name        String
    description String
    createAt    DateTime                @default(now()) @map("create_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    updateAt    DateTime                @updatedAt @map("update_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    deletedAt   DateTime?               @map("deleted_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    status      PaymentMethodStatusEnum @default(active)

    transaction        transaction[]
    transactionSession transactionSession[]

    @@map("Payment_Method")
}

model transaction {
    id                   String                @id @default(cuid())
    billId               String
    /// @DtoRelationCanConnectOnCreate
    bill                 bill                  @relation(fields: [billId], references: [id])
    transactionSessionCode String
    paymentMethodId      String                @map("payment_method_id")
    /// @DtoRelationCanConnectOnCreate
    paymentMethod        paymentMethod         @relation(fields: [paymentMethodId], references: [id])
    /// @DtoUpdateHidden
    amount               Int
    /// @DtoUpdateHidden
    bankCode             String                @map("bank_code")
    /// @DtoUpdateHidden
    cardType             String                @map("card_type")
    description          String
    /// @DtoUpdateHidden
    BankTransactionCode  String                @map("bank_transaction_code")
    /// @DtoUpdateHidden
    transactionCode      String                @map("transaction_code")
    transactionTarget    TransactionTargetEnum @map("transaction_target")
    createAt             DateTime              @map("create_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    updateAt             DateTime              @updatedAt @map("update_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    deletedAt            DateTime?             @map("deleted_at")
    /// @DtoCreateOptional
    /// @DtoUpdateHidden
    status               TransactionStatusEnum @default(pending)

    @@map("Transaction")
}

model bill {
    id                  String         @id @default(cuid())
    /// @DtoUpdateHidden
    userId              String         @map("userId")
    /// @DtoRelationCanConnectOnCreate
    user                user           @relation(fields: [userId], references: [id])
    transactionTargetId String         @map("transaction_id")
    reductionPrice      Int            @map("reduction_price")
    totalPrice          Int            @map("total_price")
    createAt            DateTime       @default(now()) @map("create_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    updateAt            DateTime       @updatedAt @map("update_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    deletedAt           DateTime?      @map("deleted_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    status              BillStatusEnum @default(pending)

    /// @DtoRelationCanCreateOnCreate
    infoBill           infoBill[]
    infoBillDiscount   infoBillDiscount[]
    discountForBill    discountForBill[]
    transaction        transaction[]
    transactionSession transactionSession[]

    @@map("Bill")
}

model infoBill {
    id                String          @id @default(cuid())
    /// @DtoUpdateHidden
    billId            String          @map("bill_id")
    bill              bill            @relation(fields: [billId], references: [id])
    productScheduleId String          @map("product_schedule_id")
    /// @DtoRelationCanConnectOnCreate
    productSchedule   productSchedule @relation(fields: [productScheduleId], references: [id])
    /// @minimum 0
    quantity          Int

    @@map("Info_Bill")
}

model infoBillDiscount {
    id         String   @id @default(cuid())
    billId     String   @map("bill_id")
    /// @DtoRelationCanConnectOnCreate
    bill       bill     @relation(fields: [billId], references: [id])
    discountId String   @map("discount_id")
    /// @DtoRelationCanConnectOnCreate
    discount   discount @relation(fields: [discountId], references: [id])

    @@map("Info_Bill_Discount")
}

model discountForBill {
    id         String   @id @default(cuid())
    billId     String   @map("bill_id")
    /// @DtoRelationCanConnectOnCreate
    bill       bill     @relation(fields: [billId], references: [id])
    discountId String   @map("discount_id")
    /// @DtoRelationCanConnectOnCreate
    discount   discount @relation(fields: [discountId], references: [id])

    @@map("Discount_For_Bill")
}

model cart {
    id                String          @id @default(cuid())
    /// @DtoUpdateHidden
    userId            String          @map("user_id")
    /// @DtoRelationCanConnectOnCreate
    user              user            @relation(fields: [userId], references: [id])
    productScheduleId String          @map("product_schedule_id")
    /// @DtoRelationCanConnectOnCreate
    productSchedule   productSchedule @relation(fields: [productScheduleId], references: [id])

    @@map("Cart")
}
