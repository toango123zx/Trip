enum GenderUserEnum {
    male
    female
    other

    @@map("Gender_User_Enum")
}

enum RoleStatusEnum {
    active
    inactive

    @@map("Role_Status_Enum")
}

enum PermissionStatusEnum {
    active
    inactive

    @@map("Permission_Status_Enum")
}

enum AccountExternalStatusEnum {
    active
    verificationPending @map("verification_pending")
    locked
    inactive

    @@map("Account_External_Status_Enum")
}

enum UserStatusEnum {
    active
    locked
    inactive

    @@map("User_Status_Enum")
}

enum AccountStatusEnum {
    active
    verificationPending @map("verification_pending")
    locked

    @@map("Account_Status_Enum")
}

enum VerifyEmailStatusEnum {
    active
    used
    overdue
    inactive

    @@map("Verify_Email_Status_Enum")
}

model role {
    id          String         @id @default(cuid())
    name        String
    description String
    createAt    DateTime       @default(now()) @map("create_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    updateAt    DateTime       @updatedAt @map("update_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    deletedAt   DateTime?      @map("deleted_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    status      RoleStatusEnum @default(active)

    infoPermission infoPermission[]
    user           user[]

    @@map("Role")
}

model permission {
    id          String               @id @default(cuid())
    name        String
    description String
    createAt    DateTime             @default(now()) @map("create_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    updateAt    DateTime             @updatedAt @map("update_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    deletedAt   DateTime?            @map("deleted_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    status      PermissionStatusEnum @default(active)

    infoPermission infoPermission[]

    @@map("Permission")
}

model infoPermission {
    id            String     @id @default(cuid())
    role_id       String     @map("roleId")
    role          role       @relation(fields: [role_id], references: [id])
    permission_id String     @map("permissionId")
    permission    permission @relation(fields: [permission_id], references: [id])
    description   String
    createAt      DateTime   @default(now()) @map("create_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    updateAt      DateTime   @updatedAt @map("update_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    deletedAt     DateTime?  @map("deleted_at")

    @@map("Info_Permission")
}

model user {
    id          String          @id @default(cuid())
    name        String
    roleId      String          @map("role_id")
    /// @DtoRelationCanConnectOnCreate
    /// @DtoRelationCanConnectOnUpdate
    role        role            @relation(fields: [roleId], references: [id])
    /// @DtoCreateOptional
    /// @DtoUpdateOptional
    image       String          @default("https://11")
    gender      GenderUserEnum?
    email       String          @unique
    dateOfBirth DateTime?       @map("date_of_birth")
    phoneNumber String?         @map("phone_number") @db.Char(10)
    address     String?
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    balance     Int             @default(0)
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    point       Int             @default(0)
    createAt    DateTime        @default(now()) @map("create_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    updateAt    DateTime        @updatedAt @map("update_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    deletedAt   DateTime?       @map("deleted_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    status      UserStatusEnum  @default(active)

    ///@DtoRelationCanCreateOnCreate
    supplier supplier?

    productRate     productRate[]
    accountExternal accountExternal?
    account         account?
    bill            bill[]
    cart            cart[]
    discount        discount[]
    boxChatMember   boxChatMember[]
    message         message[]
    productViewLog  productViewLog[]

    @@map("User")
}

model accountExternal {
    id                      String                      @id @default(cuid())
    /// @DtoUpdateHidden
    userId                  String                      @unique @map("user_id")
    /// @DtoRelationCanConnectOnCreate
    user                    user                        @relation(fields: [userId], references: [id])
    providerAccountExternal ProviderAccountExternalEnum @map("provider_account_external")
    providerToken           String                      @map("provider_token")
    createAt                DateTime                    @default(now()) @map("create_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    updateAt                DateTime                    @updatedAt @map("update_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    deletedAt               DateTime?                   @map("deleted_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    status                  AccountExternalStatusEnum   @default(active)

    @@map("Account_External")
}

model account {
    id          String            @id @default(cuid())
    /// @DtoUpdateHidden
    username    String            @unique
    password    String
    salt        String
    /// @DtoUpdateHidden
    userId      String            @unique @map("user_id")
    /// @DtoRelationCanCreateOnCreate
    /// @DtoUpdateHidden
    user        user              @relation(fields: [userId], references: [id])
    createAt    DateTime          @default(now()) @map("create_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    updateAt    DateTime          @updatedAt @map("update_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    deletedAt   DateTime?         @map("deleted_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    status      AccountStatusEnum @default(active)
    verifyEmail verifyEmail[]

    @@map("Account")
}

model verifyEmail {
    id        String                @id @default(cuid())
    /// @DtoUpdateHidden
    content   String
    /// @DtoUpdateHidden
    duration  DateTime
    /// @DtoUpdateHidden
    accountId String                @map("account_id")
    /// @DtoRelationCanConnectOnCreate
    account   account               @relation(fields: [accountId], references: [id])
    createAt  DateTime              @default(now()) @map("create_at")
    /// @DtoCreateHidden
    /// @DtoUpdateHidden
    status    VerifyEmailStatusEnum @default(active)

    @@map("Verify_Email")
}

model supplier {
    id     String @id @default(cuid())
    /// @DtoUpdateHidden
    /// @DtoConnectHidden
    userId String @unique @map("user_id")
    /// @DtoRelationCanConnectOnCreate
    user   user   @relation(fields: [userId], references: [id])
    taxId  String @map("tax_id") @db.VarChar(13)
    /// @minimum 1
    /// @maximum 100
    fee    Int    @default(10)

    product product[]

    @@map("Supplier")
}
