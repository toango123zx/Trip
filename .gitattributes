# ========================================
# Text files - force LF line endings
# ========================================
*.js      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.html    text eol=lf
*.prisma  text eol=lf
*.env     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf
*.lock    text eol=lf
.prettierrc     text eol=lf
.eslintrc       text eol=lf
.eslintrc.*     text eol=lf

# ========================================
# Binary files - prevent Git diff
# ========================================
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.svg     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.otf     binary

# ========================================
# Other project-specific rules
# ========================================

# Don't treat shell scripts as binary
*.sh      text eol=lf

# Treat all files as UTF-8 encoded by default
* text=auto

# Optional: Normalize line endings repo-wide (one-time)
# Run: git add --renormalize . && git commit -m "chore: normalize line endings"
